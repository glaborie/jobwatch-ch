{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "A job posting scraped from a job board.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The job title." },
        "company": { "type": "string", "description": "The company name." },
        "location": { "type": "string", "description": "The job location." },
        "url": { "type": "string", "format": "uri", "description": "The original job posting URL." },
        "source": { "type": "string", "description": "The source job board (e.g., LinkedIn, Indeed)." },
        "description": { "type": "string", "description": "A brief description or snippet of the job." },
        "scrapedAt": { "type": "string", "format": "date-time", "description": "When the job was scraped." },
        "publishedAt": { "type": "string", "format": "date-time", "description": "When the job was published." },
        "query": { "type": "string", "description": "The search query used to find this job." },
        "status": { "type": "string", "enum": ["new", "discarded", "applied"], "description": "The current status of the job application." },
        "summary": { "type": "string", "description": "An AI-generated summary of the job description." }
      },
      "required": ["title", "company", "url", "source", "scrapedAt", "status"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "User-specific preferences and filters.",
      "type": "object",
      "properties": {
        "ignoredLocations": { "type": "array", "items": { "type": "string" }, "description": "Locations to exclude from the job list." },
        "searchQueries": { "type": "array", "items": { "type": "string" }, "description": "Active search queries for scraping." },
        "selectedSources": { "type": "array", "items": { "type": "string" }, "description": "Sources enabled for scraping." },
        "excludedKeywords": { "type": "array", "items": { "type": "string" }, "description": "Keywords to filter out from job titles/descriptions." },
        "theme": { "type": "string", "enum": ["light", "dark"], "description": "The user's preferred visual theme." }
      }
    }
  },
  "firestore": {
    "/users/{userId}/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of job postings tracked by a specific user."
    },
    "/users/{userId}/settings/preferences": {
      "schema": "UserSettings",
      "description": "User-specific application preferences."
    }
  }
}
