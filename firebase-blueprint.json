{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "Represents a scraped job posting",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "summary": { "type": "string" },
        "scrapedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "query": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "applied", "discarded"] }
      },
      "required": ["title", "company", "url", "source", "scrapedAt", "status"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "User preferences and filters",
      "type": "object",
      "properties": {
        "ignoredLocations": { "type": "array", "items": { "type": "string" } },
        "searchQueries": { "type": "array", "items": { "type": "string" } },
        "selectedSources": { "type": "array", "items": { "type": "string" } },
        "excludedKeywords": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "lastScrapeAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/settings/preferences": {
      "schema": "UserSettings",
      "description": "User specific application settings"
    },
    "/users/{userId}/jobs": {
      "schema": "Job",
      "description": "User specific tracked jobs"
    },
    "/jobs": {
      "schema": "Job",
      "description": "Top level jobs collection for migration (legacy)"
    }
  }
}
