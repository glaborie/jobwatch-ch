rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Job validation
    function isValidJob(data) {
      return data.keys().hasAll(['title', 'company', 'url', 'source', 'scrapedAt', 'status'])
        && data.title is string && data.title.size() <= 500
        && data.company is string && data.company.size() <= 500
        && data.url is string && data.url.size() <= 2048
        && data.source is string && data.source.size() <= 50
        && data.status in ['new', 'applied', 'discarded']
        && (data.get('description', '') is string && data.get('description', '').size() <= 6000)
        && (data.get('summary', '') is string && data.get('summary', '').size() <= 2000);
    }

    match /jobs/{jobId} {
      // Browsers query this collection, ensure it's restricted to signed-in users for security
      // but ideally we check resource.data if individual ownership was implemented.
      // Currently, it's a shared pool for the app.
      allow list: if isSignedIn();
      allow get: if isSignedIn();

      allow create: if isSignedIn() 
        && isValidId(jobId)
        && isValidJob(incoming());

      allow update: if isSignedIn()
        && isValidJob(incoming())
        && (
          // Action: Scraper update or User status update or AI summary update
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['summary'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'company', 'url', 'source', 'scrapedAt', 'status', 'description', 'query', 'location', 'summary'])
        );
      
      allow delete: if false; // Prevention of accidental data loss
    }

    match /users/{userId}/settings/preferences {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
