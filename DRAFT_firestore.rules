rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprint: Job
    function isValidJob(data) {
      return data.keys().hasAll(['title', 'company', 'url', 'source', 'scrapedAt', 'status'])
        && (data.keys().size() >= 6 && data.keys().size() <= 10) // title, company, url, source, scrapedAt, status, description, location, query, summary
        && data.title is string && data.title.size() <= 500
        && data.company is string && data.company.size() <= 500
        && data.url is string && data.url.size() <= 2048
        && data.source is string && data.source.size() <= 100
        && data.status in ['new', 'applied', 'discarded']
        && (data.get('description', '') is string && data.get('description', '').size() <= 6000)
        && (data.get('location', '') is string && data.get('location', '').size() <= 200)
        && (data.get('query', '') is string && data.get('query', '').size() <= 200)
        && (data.get('summary', '') is string && data.get('summary', '').size() <= 3000);
    }

    // Validation Blueprint: UserSettings
    function isValidSettings(data) {
      return data.get('ignoredLocations', []) is list
        && data.get('searchQueries', []) is list
        && data.get('selectedSources', []) is list
        && data.get('excludedKeywords', []) is list
        && (data.get('theme', 'light') in ['light', 'dark']);
    }

    // Match Groups
    match /users/{userId} {
      // User Settings
      match /settings/preferences {
        allow read: if isOwner(userId);
        allow write: if isVerified() && isOwner(userId) && isValidSettings(incoming());
      }

      // User Jobs
      match /jobs/{jobId} {
        // Secure List Queries (Pillar 8): Implicitly restricted by path variable userId == request.auth.uid
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(jobId);

        allow create: if isVerified() && isOwner(userId) && isValidId(jobId) && isValidJob(incoming());

        allow update: if isVerified() && isOwner(userId) && isValidId(jobId) && isValidJob(incoming()) && (
          // Action: Update Status
          (incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          // Action: AI Summary
          (incoming().diff(existing()).affectedKeys().hasOnly(['summary'])) ||
          // Action: Full Scraper Update (if needed, but usually we don't re-create)
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'company', 'url', 'source', 'scrapedAt', 'description', 'location', 'query', 'status', 'summary']))
        );

        allow delete: if isOwner(userId); // Users can delete their own job tracking records
      }
    }
  }
}
